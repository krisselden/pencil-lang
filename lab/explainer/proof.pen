// Three beats of docs/plan-explainer.md, as the proof of phase 3: the mirror, the roulette and
// the glow. Not the video yet: just enough of it to see the language's new pieces together.
doc proof
viewport { x: -1.6..9.4, y: -5.5..5.5 }

pause 0.5
beat mirror "Reflect 1 across the tangent at C." for 1.5 show tangent_at_C, chord, normal, E, name_e focus .mirror
pause 1
beat roulette "Add the arms: hub, slow, fast. That's squaring." for 1.5 show hub, slow, fast, .term drop name_e focus .arm, .term
pause 1
beat glow "" for 3 show rings drop tangent_at_C, chord, normal, hub, slow, fast, .term
pause 1

let s = ln(sqrt(8))
let t = 0.6
let one = (1, 0)
let A = (cosh(s)², 0)
let R = sinh(s)·cosh(s)
curve central = circle(A, A + (R, 0))
curve limacon = parametric (u): one + (sinh(2·s) + 2·sinh(s)²·cos(u))·(cos(u), sin(u)) for u in 0..tau

let C = A + R·(cos(t), sin(t))
let along_tangent = (-sin(t), cos(t))
let E = mirror(one, perpendicular(C, line(A, C)))
segment tangent_at_C = C - 2.6·along_tangent, C + 2.6·along_tangent tag mirror
segment chord = one, C tag mirror
segment normal = C, E tag mirror
label name_e = "z²" at E away E - C tag callout

let A2 = mirror(A, C)
arrow hub = (0, 0), A tag arm, hub
arrow slow = A, A2 tag arm, slow
arrow fast = A2, E tag arm, fast

place at_sum = (-1.3, 4.6)
expression sum by beat {
  empty
  "z² = hub:a² + slow:2ab +.1 fast:b²" at at_sum
  "z² = hub:a² + slow:2ab +.1 fast:b²" at at_sum
}

circles rings = circle(c, one) for i in 0..23 with angle = tau·i / 24, c = A + R·(cos(angle), sin(angle))

dot one, C, E
