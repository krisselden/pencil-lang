// Written together, `2ab` is one term. The next state has no `2ab`, so nothing can move: it
// fades out where it is, and `2a` and `b` fade in where they're going. Beside spaced.pen, which
// differs only in its spaces. See web/terms.html.
doc joined

viewport { x: 0..6, y: 0..2 }

pause 0.5
beat write for 0.5
pause 1
beat part for 1.5
pause 1.5

place product = (1.2, 1)
place apart = (4.2, 1)

expression e {
  on write: "2ab" at product
  on part: "2a" at product, "b" at apart
}
