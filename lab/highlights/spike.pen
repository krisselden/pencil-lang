// Highlights tried on the squaring story: see docs/plan-explainer.md, and render.sh here.
doc spike
duration 12
viewport { x: -2.4..9.6, y: -6..6 }

let n = sqrt(8)
let x0 = (n + 1 / n) / 2
let r = (n - 1 / n) / 2
param u = 1.1 in 0..6.2831853
bind u = 1.1
fn on_circle(t) = x0 + r·exp(i·t)
fn squared(z) = z²

let O = (0, 0)
let Z = on_circle(u)
let W = squared(Z)
let A2 = x0²
let turn = r·exp(i·u)
let SLOW = A2 + 2·x0·turn
let H = A2 + x0·turn
let fixed_point = (1, 0)
let dimple = squared(on_circle(pi))
let Ring = dimple
let Near = dimple + (-1.3, 2.3)
let spot_center = dimple + (0.3, 0)

group shape() {
  curve whole = parametric (t): on_circle(t) for t in 0..tau
  curve part = parametric (t): on_circle(t) for t in pi - 0.75..pi + 0.75
}
use shape()
use shape() through squared as image

curve unit = circle(0, 1)
arrow hub = O, A2
arrow slow = A2, SLOW
arrow fast = SLOW, W
curve touching = circle(H, W)
curve spot = circle(spot_center, spot_center + (1.5, 0))
segment leader = dimple, Near
dot Z, W, H, Ring
label note_dimple = "the dimple" at Near offset (-34, -10) tag note
label note_z = "z" at Z offset (8, -8)
label note_w = "z²" at W offset (8, -8)

place at_eq = (3.4, -4.9)
param step = 1 in 0..1
expression eq by step {
  "z² = a² + 2ab +.1 b²" at at_eq
}
