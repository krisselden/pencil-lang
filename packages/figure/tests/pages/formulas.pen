// Labels with mathematics in them, for the tests of how a page sets what the core lays out.
doc formulas
viewport { x: 0..8, y: 0..4 }
let n = 3
let w = (-0.5, 0.866)
let v = (-0.5, sqrt(3)/2)
label map = "$f: ℝ → ℝ$" at (1.3, 3.4)
label gradient = "$∇f(x_0) = 0$" at (3.9, 3.4)
label area = "area = $x^2/2$" at (6.5, 3.4)
label circle = "$x^2 + y^2 = r^2$" at (1.4, 2.4)
label order = "$a_1 ≤ a_2 ≠ a_n^2$" at (3.9, 2.4)
label power = "$z ↦ z^{n}, z ∈ ℂ$" at (6.5, 2.4)
label root = "$sqrt(x^2 + 1)$" at (1.2, 1.4)
label quarter = "$(1/2)^2 = 1/4$" at (3.6, 1.4)
label euler = "$e^(iπ) + 1 = 0$" at (6.3, 1.4)
label trig = "$sin^2 θ + cos^2 θ = 1$" at (1.6, 0.5)
label ratio = "$√(a/b) = abs(z)/2π r$" at (4.2, 0.5)
label w at (6.8, 0.5)
label plain = "Pencil" at (7.2, 3.8)
label note = "arg z" at (0.8, 3.8)
label v = "turn" at (4.0, 3.8)
