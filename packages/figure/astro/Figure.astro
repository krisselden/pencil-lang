---
// A Pencil figure on an Astro page. A build compiles it and draws its poster, for each set of
// sheets a reader can get, and writes the element around them:
//
//   <Figure src="tube.pen" sheets="theme.style tube.style" dark="dark.style" alt="…" />
//
// The poster is an image with the figure's size, so the page is laid out before any script runs,
// offered as WebP where that's smaller, with the PNG behind it,
// and it shows until the figure's first frame and wherever a figure can't run. The element swaps
// itself in over it without anything moving. `astro dev` gives the element the sources too, and a
// figure follows its files as they're edited.
//
// `sheets` are always applied. `dark` are added after them when the reader's theme is dark, and
// `narrow` before those when `narrowMedia` matches, as a sheet that reshapes a figure for a phone.
// Paths are from the integration's `root`. `alt` says what the figure shows, for the poster and
// for the figure. `poster` picks another moment than the document's own: `{ time, params }`.
// `priority` is for a figure a reader sees before scrolling: its poster is likely the largest
// thing painted first, so it's fetched at once and ahead of the rest. Every other poster waits
// until it's near, and a page should mark one figure or two, since marking them all marks none.
// A build knows what such a figure will fetch once its script runs, the compiled figure and the
// WASM, so a line of script in the page starts on them as it's read, behind the poster.
// A page that pins a theme over the reader's system says so with `color-scheme` in its CSS, and
// a figure with `dark` sheets follows it (`src/scheme.js`), from the first paint.
// `controls` writes the default controls into the page, from what the build says of the figure, as
// it will stand when it starts and disabled, with every size reserved, so they have their place
// before any script runs and nothing moves when the figure loads. They're `<pencil-controls>`, with
// a declarative shadow root, and the element turns them on. Anything the page puts in the
// component's `controls` slot is shown after them, and on a phone in their menu.
// Anything else (`id`, `class`, `params`, `paused`, `gl`, `data-*`) goes on `<pencil-figure>`.
import { alternates, build } from './build.js';
import { settle } from '../src/scheme.js';
import { declarative, hasControls, shape as controlsShape } from '../src/controls.js';
import wasm from '../pkg/pencil_web_bg.wasm?url';

interface Props {
  src: string;
  sheets?: string | string[];
  dark?: string | string[];
  narrow?: string | string[];
  /** When `narrow` applies: one media condition. */
  narrowMedia?: string;
  alt: string;
  poster?: { time?: number; params?: Record<string, number> };
  /** The figure is in view when the page opens. */
  priority?: boolean;
  /** The default controls, written at build: play and time, beats, a control for each param a
   * handle doesn't set, and the readouts. */
  controls?: boolean;
  [attribute: string]: unknown;
}

const { src, sheets, dark, narrow, narrowMedia, alt, poster = {}, priority = false, controls = false, ...attributes } = Astro.props;
// As in `<picture>`, the first choice that matches wins, so the narrowest case comes first.
const { sheets: always, others: choices } = alternates({ sheets, dark, narrow, narrowMedia });

const [main, ...others] = await Promise.all(
  [{ sheets: always }, ...choices].map((choice) => build({ src, sheets: choice.sheets, ...poster })),
);
// A build ships the compiled figure. `astro dev` hands over the sources.
const from = (built: Awaited<ReturnType<typeof build>>) =>
  built.src ? { src: built.src, sheets: (built.sheets ?? []).join(' ') } : { compiled: built.compiled };

// The poster takes the figure's exact shape, which its own pixels only round to, so nothing
// moves by even a pixel when the figure takes over. A choice with another shape, as a narrow
// sheet gives, says so under its media query. Later rules win, so they go in reverse.
const shape = (built: Awaited<ReturnType<typeof build>>) => (built.info ? built.info.size.join(' / ') : undefined);
const reshaped = others
  .map((built, i) => ({ media: choices[i].media, shape: shape(built) }))
  .filter((each) => each.shape && each.shape !== shape(main))
  .reverse();
// A line of script in the figure runs as the page is read, before the element's own. It answers
// `prefers-color-scheme` for a page that pins a theme, so the poster painted first is the right
// one. And for a figure in view it starts on what the element will fetch, the WASM and the
// compiled figure for the first choice whose media matches, and leaves them for it (`ahead`, in
// host.js). `astro dev` loads the sources, so there that would fetch what's never used.
//
// The poster a browser fetches first can be the other theme's, for a reader whose page pins one
// against their system: while the page's stylesheet loads, which the script waits for, the browser
// reads ahead and fetches the image the system picks. The poster painted is still the pinned one.
// A `priority` poster stays eager anyway, since it's likely the page's largest first paint, and
// that one extra fetch is only for the few who pin. (A script between the `<source>`s and the
// `<img>` was measured, and is worse: then a browser reading ahead ignores the sources and fetches
// the fallback, for every reader.)
const themed = choices.some((choice) => choice.media.includes('prefers-color-scheme'));
const early = priority && main.compiled && !main.src;
const fetchAhead = `const s=self.__pencilAhead??={},get=(u)=>fetch(u,{priority:'low'}).catch(()=>null);s.wasm??=get(${JSON.stringify(wasm).replace(/</g, '\\u003c')});const c=([...f.children].find((e)=>e.localName==='source'&&(!e.media||matchMedia(e.media).matches))??f).getAttribute('compiled');if(c){const u=new URL(c,document.baseURI).href;s[u]??=get(u)}`;
const start = (themed || early)
  ? `((f)=>{${themed ? `(${String(settle).replace(/\n\s+/g, '\n')})(f);` : ''}${early ? fetchAhead : ''}})(document.currentScript.parentElement)`
  : undefined;
const mark = reshaped.length ? main.hash : undefined;
// The controls as the figure starts: at the poster's moment, paused if the page starts it paused,
// and disabled until it loads. A figure that doesn't compile, in `astro dev`, gets its controls
// from the element once it does.
// What the page put in the `controls` slot, which can be nothing: a slot written with a condition is
// there whether or not the condition holds.
const own = Astro.slots.has('controls') ? (await Astro.slots.render('controls')).trim() : '';
const extra = own !== '';
const written = controls && main.info && (hasControls(main.info) || extra)
  ? declarative({ info: main.info, moment: main.moment, paused: Boolean(attributes.paused), disabled: true, extra })
  : null;
const rules = reshaped
  .map((each) => `@media ${each.media}{[data-pencil-poster="${mark}"] img{--pencil-shape:${each.shape}}}`)
  .join('');
---
{mark && <style is:inline set:html={rules}></style>}
<pencil-figure {...attributes} {...from(main)} aria-label={alt} data-pencil-poster={mark} controls={controls || undefined}>
  {others.map((built, i) => <source media={choices[i].media} {...from(built)} />)}
  {main.poster && (
    <picture style={shape(main) && `--pencil-shape: ${shape(main)}`}>
      {others.map((built, i) => built.poster && (
        <>
          {built.poster.webp && <source media={choices[i].media} type="image/webp" srcset={built.poster.webp} width={built.poster.width} height={built.poster.height} />}
          <source media={choices[i].media} srcset={built.poster.srcset ?? built.poster.src} width={built.poster.width} height={built.poster.height} />
        </>
      ))}
      {main.poster.webp && <source type="image/webp" srcset={main.poster.webp} width={main.poster.width} height={main.poster.height} />}
      <img
        src={main.poster.src}
        srcset={main.poster.srcset}
        width={main.poster.width}
        height={main.poster.height}
        alt={alt}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        style="display: block; width: 100%; height: auto; aspect-ratio: var(--pencil-shape, auto)"
      />
    </picture>
  )}
  {start && <script is:inline set:html={start}></script>}
  {(written || extra) && (
    <pencil-controls slot="controls" data-shape={written ? controlsShape(main.info) : undefined}>
      {written && <Fragment set:html={written} />}
      {extra && <Fragment set:html={own} />}
    </pencil-controls>
  )}
</pencil-figure>

<script>
  import './client.js';
</script>
