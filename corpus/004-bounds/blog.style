// The blog's construction style, in its 560-wide drawing units, and its labels in ems. Results take their beat's
// color and stay. Scaffolding is thin and muted, and fades once its beat has passed.
style figure { width: 560px; height: 400px }

style paper      { fill: rgb(242, 240, 235) }

style circle     { width: 2px; opacity: reveal(self.age, 1, 0.75); fill_opacity: reveal(self.age, 0.14, 0.08) }
style circle.red            { stroke: oklch(0.51, 0.15, 27) }
style circle.red::inside    { fill: oklch(0.51, 0.15, 27) }
style circle.blue           { stroke: oklch(0.51, 0.145, 250) }
style circle.blue::inside   { fill: oklch(0.51, 0.145, 250) }
style circle.pink           { stroke: oklch(0.51, 0.15, 345) }
style circle.pink::inside   { fill: oklch(0.51, 0.15, 345) }

style line, ray  { stroke: rgb(110, 106, 99); width: 1.25px; dash: 10px; gap: 8px; opacity: reveal(self.age, 0.9, 0.45) }
style .aux       { stroke: rgb(110, 106, 99); width: 1.25px; opacity: reveal(self.age, 0.9, 0.45); fill_opacity: 0 }
style level      { stroke: rgb(96, 66, 166); width: 2px; opacity: reveal(self.age, 1, 0.75) }

// A point shows during its beat. Named points stay.
style dot        { radius: 4.75px; opacity: reveal(self.age, 1, 0) }
style dot.ink    { fill: rgb(18, 17, 15) }
style dot.red    { fill: oklch(0.51, 0.15, 27) }
style dot.blue   { fill: oklch(0.51, 0.145, 250) }
style dot.pink   { fill: oklch(0.51, 0.15, 345) }
style .named     { opacity: reveal(self.age, 1, 1) }
style P          { fill: rgb(242, 240, 235); stroke: rgb(18, 17, 15); width: 4px; radius: 9px; opacity: 1 }

style one, name_p { fill: rgb(18, 17, 15); size: 1em; halo: 0.2em; font: math }
