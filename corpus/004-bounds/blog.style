// The blog's construction style, in its 560-wide drawing units, and its labels in ems. Results take their beat's
// color and stay. Scaffolding is thin and muted, and fades once its beat has passed.
style figure { width: 560px; height: 400px }

style paper      { fill: rgb(242, 240, 235) }

style circle     { width: 2px; opacity: reveal(self.age, 1, 0.75)·mix(0.2, 1, self.focus); fill_opacity: reveal(self.age, 0.14, 0.08)·self.focus }
style circle.ratio            { stroke: oklch(0.51, 0.15, 27) }
style circle.ratio::inside    { fill: oklch(0.51, 0.15, 27) }
style circle.boundary           { stroke: oklch(0.51, 0.145, 250) }
style circle.boundary::inside   { fill: oklch(0.51, 0.145, 250) }
style circle.middle           { stroke: oklch(0.51, 0.15, 345) }
style circle.middle::inside   { fill: oklch(0.51, 0.15, 345) }

style line, ray  { stroke: rgb(110, 106, 99); width: 1.25px; dash: 10px; gap: 8px; opacity: reveal(self.age, 0.9, 0.45)·mix(0.2, 1, self.focus) }
style .aux       { stroke: rgb(110, 106, 99); width: 1.25px; opacity: reveal(self.age, 0.9, 0.45); fill_opacity: 0 }
style level      { stroke: rgb(96, 66, 166); width: 2px; opacity: reveal(self.age, 1, 0.75) }

// A point shows during its beat. Named points stay.
style dot        { radius: 4.75px; opacity: reveal(self.age, 1, 0)·self.focus }
style dot.given    { fill: rgb(18, 17, 15) }
style dot.ratio    { fill: oklch(0.51, 0.15, 27) }
style dot.boundary   { fill: oklch(0.51, 0.145, 250) }
style dot.middle   { fill: oklch(0.51, 0.15, 345) }
style .named     { opacity: reveal(self.age, 1, 1)·mix(0.2, 1, self.focus) }
// The handle: a ring, small enough not to hide what's near P.
style P          { fill: rgb(242, 240, 235); stroke: rgb(18, 17, 15); width: 2px; radius: 5.5px; opacity: 1 }
style base, step { stroke: rgb(18, 17, 15); width: 1.5px; dash: none; opacity: reveal(self.age, 1, 1) }

style one, name_p, zero, name_b, name_f { fill: rgb(18, 17, 15); size: 1em; halo: 0.2em; font: math }
// Named in a caption, so each shows from its beat on.
style zero, name_b, name_f { opacity: reveal(self.age, 1, 1)·mix(0.2, 1, self.focus) }
