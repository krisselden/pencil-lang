// What every figure shares, as in the site's design system. A document picks a role by tag,
// and never a number. `name` is any label without another role.
let ink = rgb(28, 27, 25)
let paper_color = rgb(251, 250, 247)
let muted = rgb(107, 103, 95)
let blue = rgb(46, 98, 168)
let red = rgb(181, 68, 60)

style paper { fill: paper_color }

style label { size: 17px; font: math; halo: 3px; fill: ink; place: settle }
style label.note { size: 15px; font: math }
style label.tick { size: 12px; font: sans; fill: muted }
style label.display { size: 64px; font: math; place: fixed }
