// The hearts as light on black, which a graphing calculator can't do: every circle of the grid
// and each heart is a line that glows by its distance, they add where they meet, and `tanh` keeps
// the sum in range. So the crossings burn white, and so do the foci, where every circle of
// constant σ passes.
style figure { width: 640px; height: 640px }

style paper { fill: black; tone: tanh }

let rose = rgb(255, 77, 136)
let sky = rgb(77, 196, 255)
let violet = rgb(420, 260, 1100)
let indigo = rgb(260, 420, 1100)

// A line of light `w` device pixels wide, however large the figure is drawn.
fn glow(d, w) = tanh(w·self.pixel / abs(d))

style .grid { blend: add; fill_opacity: 0.22·glow(self.dist, 0.5) }
style through_foci::inside { fill: violet }
style through_foci::outside { fill: violet }
style around_foci::inside { fill: indigo }
style around_foci::outside { fill: indigo }

// A heart's stroke is drawn per pixel, as wide as the figure, and fades with its distance from the
// curve as it is traced, so the light runs right through the foci, where the heart turns back.
style .heart { draw: field; blend: add; width: 8; opacity: glow(self.dist, 2.5) }
style heart_a { stroke: rose·2.5 }
style heart_b { stroke: sky·2.5 }

style .coordinate { stroke: white; width: 1.5px; opacity: 0.7 }
style dot { fill: white; radius: 4.5px }
