// Two hearts in bipolar coordinates, from Kris's Desmos graph "Bipolar Hearts". Every point is
// z = coth((τ − σi)/2), where σ is the angle the foci ±1 subtend at z, and τ = ln(|z + 1| / |z − 1|).
// A heart ties them together through one angle, so as σ goes around, τ runs out to a focus and back.
doc hearts
duration 12
// At time 0 the moving points are on the foci, so a still shows them a fifth of the way round.
poster { time: 2.4 }

viewport { x: -2..2, y: -2..2 }

param theta in 0..2·π
bind theta = mod(time, 12) / 12·2·π
param shift = 0 in 0..2·π

fn bipolar(σ, τ) = coth((τ - σ·i) / 2)
// Just short of 1, so that τ stays finite at the foci.
fn tau_of(a) = arctanh(cos(a - pi)·0.999999)
fn sigma_of(a) = a + shift

// The circles through the moving points: one of constant τ, and two arcs of constant σ.
curve level_tau = parametric (t): bipolar(sigma_of(t), tau_of(theta)) for t in 0..2·π tag first, coordinate
curve level_sigma_a = parametric (t): bipolar(sigma_of(theta), tau_of(t)) for t in 0..2·π tag second, coordinate
curve level_sigma_b = parametric (t): bipolar(sigma_of(theta + pi), tau_of(t)) for t in 0..2·π tag second, coordinate

// The coordinate grid: circles of constant σ, which all pass through both foci, and circles of
// constant τ around them, at the τ the hearts have at evenly spaced angles. σ and σ + π are the two
// arcs of one circle, so eight of them are the graph's sixteen, and the last is the line through
// the foci. τ = 0 is the line between them.
let N = 16
circles through_foci = circle(-1, bipolar(k·2·π / N, 0), 1) for k in 1..8 tag grid
circles around_foci = circle(bipolar(π / 2, τ), bipolar(π, τ), bipolar(3·π / 2, τ)) for k in 1..15 with τ = tau_of(k·π / N) tag grid

curve heart_a = parametric (t): bipolar(sigma_of(t), tau_of(t)) for t in 0..2·π tag first, heart
curve heart_b = parametric (t): bipolar(sigma_of(t), tau_of(t + pi)) for t in 0..2·π tag second, heart

let z_a = bipolar(sigma_of(theta), tau_of(theta))
let z_b = bipolar(sigma_of(theta + pi), tau_of(theta))

// What σ is: the angle at z between the two foci.
segment ties_a = -1, z_a, 1 tag first, ties
segment ties_b = -1, z_b, 1 tag second, ties

// The foci, which every heart and every circle of constant σ passes through.
let focus_left = -1
let focus_right = 1
dot focus_left, focus_right tag focus

dot z_a tag first
dot z_b tag second
