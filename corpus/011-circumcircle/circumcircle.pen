// The circumcircle of a triangle whose corners chase each other around a Lissajous curve, from
// Kris's shader. The triangle turns over whenever its corners pass, and the circle goes through a
// line to come out the other way round. Its sides don't notice, so the plane doesn't flash.
doc circumcircle
duration 17.95

viewport { x: -2.4..2.4, y: -1.5..1.5, width: 640, height: 400 }

fn route(t) = (cos(3·t + 4), sin(2·t + 5.88))

let t = 0.35·time
let A = route(t)
let B = route(t + 2.5)
let C = route(t + 1.3)

curve around = circle(A, B, C)
curve path = parametric (s): route(s) for s in 0..tau
region turned = A, B, C
dot A, B, C
