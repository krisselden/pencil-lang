// F.O.I.L. on z², physically. z = a + bi is a right triangle. Multiplying by z is F.O., a
// copy of z scaled by a, plus I.L., a copy of z scaled by b and turned 90° by i, tip to tail.
// Those are the legs of a right triangle similar to the first, scaled by |z| and turned.
// Numbers have length, negative turns 180°, and i turns 90°, which is where right triangles
// and trig come from.
doc square
duration 19

viewport { x: -0.7..2.7, y: -0.35..2.0 }

// One beat per move, with a pause where the figure holds. A reader or a clock can drive it.
pause 0.4
beat build_a for 0.8
pause 0.3
beat build_b for 0.7
pause 0.3
beat join for 0.7
pause 0.3
beat name for 0.6 show hypotenuse
pause 0.9
beat shorten for 0.5
pause 0.2
beat measure for 0.5 show arg_first, length_z
pause 0.8
beat unmeasure for 0.5 drop arg_first, length_z
pause 0.3
// Once z is built, its parts step back so the multiply reads.
beat scale_a for 1.1 show fo focus fo
pause 0.3
beat scale_b for 1.0 show il
pause 0.3
beat rotate for 1.0 show turning
pause 0.3
beat slide for 0.8 drop turning
pause 0.4
beat add for 0.7 show square
pause 0.7
beat factor for 0.4
pause 0.6
beat squared for 0.4
pause 0.1
beat result for 0.6 show first_angle, second_angle, arg_first, arg_second, length_z2
pause 1.7
beat clear for 0.6 drop leg_a, leg_b, hypotenuse, fo, il, square, first_angle, second_angle, arg_first, arg_second, length_z2

fn turned(p, t) = p·exp(i·t)
fn between(p, q, s) = p + (q - p)·s

let a = 1.5
let b = 0.55
let O = (0, 0)
let Z = a + b·i
let AZ = Z·a
let BZ = Z·b
let BIZ = i·BZ
let Z2 = AZ + BIZ
let angle = atan2(b, a)

let tip_a = between(Z, AZ, snap(scale_a))
let along = turned(between(Z, BZ, snap(scale_b)), snap(rotate)·pi / 2)
let from = between(O, AZ, snap(slide))
let tip_b = from + along

segment axis_x = (-0.7, 0), (2.7, 0)
segment axis_y = (0, -0.35), (0, 2.0)

arrow leg_a = O, (a·snap(build_a), 0)
arrow leg_b = (a, 0), (a, b·snap(build_b))
arrow hypotenuse = O, Z
arrow fo = O, tip_a
curve turning = parametric (t): (cos(t)·length(BZ), sin(t)·length(BZ)) for t in angle..angle + snap(rotate)·pi / 2
arrow il = from, tip_b
arrow square = O, Z2

curve first_angle = parametric (t): (0.42·cos(t), 0.42·sin(t)) for t in 0..angle
curve second_angle = parametric (t): (0.62·cos(t), 0.62·sin(t)) for t in angle..2·angle
label arg_first = "arg z" at (0.5·cos(angle / 2), 0.5·sin(angle / 2)) offset (0, -6) tag note
label arg_second = "arg z" at (0.7·cos(1.5·angle), 0.7·sin(1.5·angle)) offset (0, -6) tag note
label length_z = "|z|" at Z·0.5 offset (-14, -12) tag note
label length_z2 = "|z|²" at Z2·0.55 offset (-18, -10) tag note

place at_a = (a / 2, 0) offset (0, 22) hang middle
place at_b = (a, b / 2) offset (6, 6)
place at_z = Z offset (10, -10)
place at_tip_a = tip_a offset (8, 18)
place at_tip_b = tip_b offset (-28, -12)
place beside_b = from + along·0.5 offset (4, 6)
place at_sum = Z2 offset (-8, -12) hang end

// A state per beat. Measuring and the result don't change it, so it's written again.
expression work by beat {
  "a" at at_a
  "a" at at_a, "+ b i" at at_b
  "a + b i" at at_z
  "z = a + b i" at at_z
  "z" at at_z
  "z" at at_z
  "z" at at_z
  "z" at at_z, "z.1 a" at at_tip_a
  "z" at at_z, "z.1 a" at at_tip_a, "z.2 b" at at_tip_b
  "z" at at_z, "z.1 a" at at_tip_a, "z.2 b i" at at_tip_b
  "z" at at_z, "z.1 a" at at_tip_a, "+ z.2 b i" at beside_b
  "z" at at_z, "z.1 a + z.2 b i" at at_sum
  "z" at at_z, "z.1 ( a + b i )" at at_sum
  "z" at at_z, "z.1 ²" at at_sum
  "z" at at_z, "z.1 ²" at at_sum
  empty
}
