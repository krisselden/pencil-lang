style axis_x, axis_y { stroke: muted; width: 1px; opacity: 0.6 }

style leg_a { stroke: blue; width: 3px; opacity: parts }
style leg_b { stroke: green; width: 3px; opacity: parts }
style hypotenuse { stroke: ink; width: 2.5px; opacity: named·fade }
style fo { stroke: blue; width: 3px; opacity: scaled_a·fade; show: scaled_a }
style il { stroke: green; width: 3px; opacity: scaled_b·fade; show: scaled_b }
style turning { stroke: green; width: 1.5px; dash: 3px; gap: 3px; opacity: rotated·(1 - slid) }
style square { stroke: ink; width: 3px; opacity: added·fade; show: added }

// Blue stays the a side and green the bi side: the color ties the big triangle to the small.
style term.a { fill: blue }
style term.b, term.i { fill: green }

style first_angle, second_angle { stroke: ink; width: 1.5px; opacity: result_shown; show: result_shown }
style arg_first { opacity: max(length_shown, result_shown); show: max(length_shown, result_shown); place: fixed }
style arg_second { opacity: result_shown; show: result_shown; place: fixed }
style length_z { opacity: length_shown; show: length_shown; place: fixed }
style length_z2 { opacity: result_shown; show: result_shown; place: fixed }
