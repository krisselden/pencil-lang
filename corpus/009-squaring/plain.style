style figure { width: 640px; height: 520px }

style curves { stroke: red; width: 1px; opacity: 0.5 }
style curves.square { stroke: accent }
style curves.moving { stroke: red; width: 1.5px; opacity: 0.8 }
style orbit { stroke: red; width: 2.5px }
style moving_orbit { stroke: red; width: 3.5px }
style square_orbit { stroke: accent; width: 2.5px }
style unit { stroke: ink; width: 1.25px }
style marker { fill: red; radius: 4px }
