// The site's look: muted circles, the rows in blue and red, and the circle at 1 in ink. The copies a
// turn away fade as it wraps.
style figure { width: 520px; height: 460px }

style .edge { stroke: muted; width: 1.25px; dash: 5px; gap: 4px }

style strip { stroke: muted; width: 1px }
style strip::inside { fill: muted }
style strip { fill_opacity: 0.08 }
style copies { stroke: muted; width: 0.75px; opacity: 0.7·flatness; show: flatness }
style copies::inside { fill: muted }
style copies { fill_opacity: 0.04 }

style .one { stroke: blue; width: 2.5px }
style .along_omega { stroke: red; width: 2.5px }
style .one.copy { stroke: blue_soft; width: 1.75px; opacity: flatness; show: flatness }
style .along_omega.copy { stroke: red_soft; width: 1.75px; opacity: flatness; show: flatness }

style circle_one { stroke: ink; width: 2px }
style circle_one::inside { fill: ink }
style circle_one { fill_opacity: 0.2 }
style name_one { place: fixed }
