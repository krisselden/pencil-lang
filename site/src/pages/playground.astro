---
// The playground is `web/playground.html` itself, served from the repo and framed here so the
// site's header stays. `?figure=<id>` is passed through, so a demo can open its own figure, and
// so is what follows `#`, where a link carries a whole figure (`#pen=…`). Nothing else is put
// around it, so a phone keeps its height for the editor and the figure: the playground itself
// offers to open alone when it's framed.
import Base from '../layouts/Base.astro';

// The site's host serves a page without its `.html`, and answers the longer address with a
// redirect to the shorter: a round trip before the playground, on every visit. So a build asks
// for the shorter. `astro dev` serves the file by its name.
const page = import.meta.env.DEV ? '/web/playground.html' : '/web/playground';
---
<Base title="Playground" section="playground" full description="Edit any Pencil figure and its style sheets in the browser, and watch it recompile.">
  <iframe class="playground" id="playground" src={page} title="Pencil playground" allow="fullscreen; clipboard-write"></iframe>
</Base>

<script>
  const frame = document.getElementById('playground') as HTMLIFrameElement;
  // The frame's own address, as the page was written with it.
  const PAGE = new URL(frame.src).pathname;
  // What says which figure: an example's id, or a whole figure after `#pen=`.
  const figure = new URLSearchParams(location.search).get('figure');
  const inner = () => `${PAGE}${figure ? `?figure=${encodeURIComponent(figure)}` : ''}${location.hash}`;
  if (figure || location.hash) frame.src = inner();
  // A link pasted into this tab while it's open is the frame's to open.
  addEventListener('hashchange', () => {
    const within = frame.contentWindow;
    if (within && within.location.hash !== location.hash) within.location.hash = location.hash;
  });
  // The playground keeps the figure it shows in its own address. Follow it, so this page's address
  // says the same, however the playground comes to change it.
  frame.addEventListener('load', () => {
    const within = frame.contentWindow;
    if (!within) return;
    const follow = () => {
      try {
        const there = new URL(within.location.href);
        const here = new URL(location.href);
        const chosen = there.searchParams.get('figure');
        if (chosen) here.searchParams.set('figure', chosen);
        here.hash = there.hash;
        if (here.href !== location.href) history.replaceState(null, '', here);
      } catch {}
    };
    follow();
    try {
      for (const name of ['replaceState', 'pushState'] as const) {
        const was = within.history[name];
        within.history[name] = function (...args: Parameters<History['replaceState']>) {
          was.apply(this, args);
          follow();
        };
      }
      within.addEventListener('hashchange', follow);
    } catch {}
  });
</script>
