---
// The playground is `web/playground.html` itself, served from the repo and framed here so the
// site's header stays. `?figure=<id>` is passed through, so a demo can open its own figure.
import Base from '../layouts/Base.astro';
---
<Base title="Playground" section="playground" full description="Edit any Pencil figure and its style sheets in the browser, and watch it recompile.">
  <div class="frame-note">
    <p>
      Edits are kept in this browser only. <a href="/web/playground.html" id="alone">Open the
      playground on its own</a>.
    </p>
  </div>
  <iframe class="playground" id="playground" src="/web/playground.html" title="Pencil playground" allow="fullscreen"></iframe>
</Base>

<script>
  const frame = document.getElementById('playground') as HTMLIFrameElement;
  const alone = document.getElementById('alone') as HTMLAnchorElement;
  const figure = new URLSearchParams(location.search).get('figure');
  if (figure) {
    const src = `/web/playground.html?figure=${encodeURIComponent(figure)}`;
    frame.src = src;
    alone.href = src;
  }
  // The playground keeps the figure it shows in its own address. Follow it, so this page's address
  // and the link out say the same.
  frame.addEventListener('load', () => {
    const watch = () => {
      try {
        const chosen = new URL(frame.contentWindow!.location.href).searchParams.get('figure');
        if (!chosen) return;
        alone.href = `/web/playground.html?figure=${encodeURIComponent(chosen)}`;
        const url = new URL(location.href);
        if (url.searchParams.get('figure') !== chosen) {
          url.searchParams.set('figure', chosen);
          history.replaceState(null, '', url);
        }
      } catch {}
    };
    watch();
    // Its menu changes the figure, and its address after.
    frame.contentDocument?.getElementById('figure-pick')?.addEventListener('change', () => setTimeout(watch));
  });
</script>
