---
import Docs from '../../layouts/Docs.astro';
import { REPO } from '../../lib/figures';

const headings = [
  { depth: 2, slug: 'what-you-need', text: 'What you need' },
  { depth: 2, slug: 'render-a-frame', text: 'Render a frame' },
  { depth: 2, slug: 'gpu-against-cpu', text: 'Compare the GPU with the CPU' },
  { depth: 2, slug: 'video', text: 'Export a video' },
  { depth: 2, slug: 'browser', text: 'Figures in a browser' },
  { depth: 2, slug: 'latex', text: 'Bring formulas from LaTeX' },
  { depth: 2, slug: 'tests', text: 'Run the tests' },
  { depth: 2, slug: 'pencil-command', text: 'The pencil command' },
