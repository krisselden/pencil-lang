---
// A live figure: the package's `<Figure>`, which builds it and its poster for each of the sheets
// its page in `web/` loads, and, unless `controls` is false, what a reader can set on it (and
// either way, why it can't draw if it can't). The controls are written here, from what the build
// says of the figure, as it will stand when it starts and disabled, so they're in the page with
// their size before the figure is. `<figure-controls>` turns them on when it loads.
import PencilFigure from '@pencil-lang/figure/Figure.astro';
import { alternates, build } from '@pencil-lang/figure/astro';
import type { Look } from '../lib/figures';
import { markup, shape } from '../scripts/controls-markup.js';

interface Props {
  id: string;
  looks: Look[];
  label: string;
  params?: string;
  paused?: boolean;
  start?: number;
  controls?: boolean;
  /** What a choice between `looks` is called: a style, by default. */
  choose?: string;
  /** The figure is in view when the page opens, so its poster is fetched first. */
  priority?: boolean;
  class?: string;
}

const { id, looks, label, params, paused, start, controls = true, choose, priority, class: className } = Astro.props;
const [look] = looks;
// The poster is the figure as the page starts it: the params it holds, at the time it starts at.
const held = Object.fromEntries(
  (params ?? '')
    .split(';')
    .map((part) => part.split(':').map((s) => s.trim()))
    .filter(([name, value]) => name && value)
    .map(([name, value]) => [name, Number(value)]),
);
const poster = { time: start, params: held };
// A tall figure fits the window's height on a wide screen rather than running off it. Its shape
// is known here, so it's that wide before it loads. The stylesheet says when `--fit-width` applies.
const { info, moment } = await build({ src: look.pen, sheets: look.sheets, ...poster });
const fit = info ? `--fit-width: calc(85vh * ${info.size[0] / info.size[1]})` : undefined;
// A figure with more than one look has each built, and its controls swap one for another. A look
// has its own sheets for a dark theme or a narrow page, or none, so each brings the `<source>`s
// the figure needs while it's the one showing: the first look's would otherwise go on applying.
type Built = Awaited<ReturnType<typeof build>>;
const from = (built: Built) =>
  built.src ? { src: built.src, sheets: built.sheets.join(' ') } : { compiled: built.compiled };
// A page that sizes figures by their tier (the demos page) reads, from the wrapper, the figure's
// shape, the width its sheets were designed at, and whether its panels stand in more than one row,
// which gets more height. Panels are always in design pixels. A figure without them has a design
// width only when its sheets give one, and without it its size is its view's, in its own units.
// Each set of sheets a reader can get has its own, so they're written as the poster's shape is:
// under each one's media query, the first that matches winning, so in reverse. A look brings its
// own rules, which the controls put in place of these when a reader picks it.
const sizing = (built: Built) => {
  const info = built.info;
  if (!info) return undefined;
  const design = info.panels.length > 1 ? info.size[0] : info.viewport.width;
  const rows = new Set(info.panels.map((panel) => panel.rect[1])).size;
  return `--aspect: ${info.size[0] / info.size[1]}; --design-width: ${design ? `${design}px` : 'initial'}; --rows: ${rows > 1 ? 2 : 1}`;
};
const at = `[data-sizes="${id}"]`;
const built = await Promise.all(
  looks.map(async (each) => {
    const { sheets, others } = alternates({ sheets: each.sheets, dark: each.dark, narrow: each.narrow });
    const [main, ...rest] = await Promise.all(
      [{ sheets }, ...others].map((choice) => build({ src: each.pen, sheets: choice.sheets, ...poster })),
    );
    const own = sizing(main);
    const sizes = [
      own && `${at}{${own}}`,
      ...rest
        .map((each, i) => ({ media: others[i].media, vars: sizing(each) }))
        .filter((each) => each.vars)
        .reverse()
        .map((each) => `@media ${each.media}{${at}{${each.vars}}}`),
    ].join('');
    const sources = rest.map((each, i) => ({ media: others[i].media, ...from(each) }));
    return { name: each.name, playground: each.playground, ...from(main), sources, sizes };
  }),
);
const choices = looks.length > 1 ? JSON.stringify(built) : undefined;
const named = choices ? JSON.parse(choices) : [];
// The poster's moment is where the figure starts, so its values are the controls' first ones.
// Without them (a figure that doesn't compile, in `astro dev`), the page writes them on load.
const written = controls && info
  ? markup({ id, info, moment, paused: Boolean(paused), looks: named, looksLabel: choose, disabled: true })
  : '';
---
{built[0].sizes && <style is:inline data-sizes-for={id} set:html={built[0].sizes}></style>}
<div class:list={['live', className]} data-sizes={id}>
  <PencilFigure
    id={id}
    src={look.pen}
    sheets={look.sheets}
    dark={look.dark}
    narrow={look.narrow}
    alt={label}
    poster={poster}
    priority={priority}
    params={params}
    paused={paused}
    data-start={start}
    style={fit}
  />
  <figure-controls
    for={id}
    looks={choices}
    looks-label={choose}
    bare={controls ? undefined : ''}
    hidden={written === '' ? true : undefined}
    data-shape={written ? shape(info, named) : undefined}
    set:html={written}
  />
</div>
