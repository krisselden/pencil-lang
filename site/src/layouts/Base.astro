---
import '../styles/site.css';
import { build } from '@pencil-lang/figure/astro';
import { DEMOS, REPO } from '../lib/figures';

interface Props {
  title?: string;
  description?: string;
  /** Which nav item is this page's. */
  section?: 'docs' | 'demos' | 'playground';
  /** Whether the page draws figures, and so loads what the site does around them (`scripts/figures.js`). The element and its controls come with each figure. */
  figures?: boolean;
  /** A page that fills the window, such as the playground's. */
  full?: boolean;
  /** Whether the page shows the logo itself, as the home page does beside its heading, so the header leaves it out. */
  logo?: boolean;
}

const {
  title,
  description = 'Pencil is a declarative language for mathematical figures. A figure is a text file that says what’s in it, and style sheets say how it looks.',
  section,
  figures = false,
  full = false,
  logo = false,
} = Astro.props;
const fullTitle = title ? `${title} · Pencil` : 'Pencil: a language for mathematical figures';
const nav = [
  { href: '/docs/', label: 'Docs', key: 'docs' },
  { href: '/demos/', label: 'Demos', key: 'demos' },
  { href: '/playground/', label: 'Playground', key: 'playground' },
];
// The link preview is the hearts figure the home page opens with, under the same sheets, then `card.style`,
// which makes the figure 1200 by 630, so its poster is the card as it is, with no paper around it.
const hearts = DEMOS.find((d) => d.id === 'hearts')!;
const glow = hearts.looks.find((look) => look.name === 'glow.style')!;
const { poster: card } = await build({ src: glow.pen, sheets: [...glow.sheets, 'corpus/008-hearts/card.style'] });
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = card ? new URL(card.src, Astro.site).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Pencil" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content={String(card.width)} />
        <meta property="og:image:height" content={String(card.height)} />
        <meta property="og:image:alt" content={hearts.label} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={image} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class:list={{ full }}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site">
      <a class="mark" href="/" aria-label="Pencil, home">{!logo && <span class="hearts" aria-hidden="true"></span>}Pencil</a>
      <nav aria-label="Site">
        {nav.map((item) => (
          <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href={REPO}>GitHub</a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    {!full && (
      <footer class="site">
        <p>
          Pencil is early, and its syntax will change. <a href={REPO}>Source on GitHub</a>, under the
          MIT license.
        </p>
      </footer>
    )}
    {figures && <script src="../scripts/figures.js"></script>}
  </body>
</html>
