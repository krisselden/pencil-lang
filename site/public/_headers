# What Cloudflare sends with the site's files. Left to itself it tells a browser to ask again for
# every file on every page, which is a round trip each and makes the tab's icon blink.

# Named for what's in them, so a copy a reader kept is never a stale one.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/_pencil/*
  Cache-Control: public, max-age=31536000, immutable

# The same names from one build to the next, so a reader has a new icon within a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
